# Server
PORT=3000
NODE_ENV=development

# MongoDB — set this for production/real database.
# If empty, the server automatically starts an embedded in-memory MongoDB
# (great for demos/evaluation; data resets on restart).
MONGODB_URI=

# Admin bootstrap account (created on first boot if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secrets — change in production
JWT_SECRET=
COOKIE_SECURE=false

# Set to "false" to skip seeding demo forms on first boot
SEED_DEMO=true
